# Throwaway OpenRouter routing evaluation for Wayfinder ticket:
# "Prototype exact lookup and discovery search routing"
#
# Copy to .env.openrouter.local, which is already ignored by .gitignore.
# Never commit the real key.
OPENROUTER_API_KEY=

# Pinned against the live OpenRouter catalogue on 2026-09-30.
OPENROUTER_QWEN_MODEL=qwen/qwen3-14b
OPENROUTER_DEEPSEEK_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_LLAMA_MODEL=meta-llama/llama-3.1-8b-instruct

# OpenRouter bills in USD. USD 9 is a conservative ceiling below EUR 10.
OPENROUTER_MAX_COST_USD=9.00
OPENROUTER_REPETITIONS=3
OPENROUTER_MAX_OUTPUT_TOKENS=2048
OPENROUTER_INTERFACES=router_v3
